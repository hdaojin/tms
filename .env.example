# -----------------------------------------------------------------------------
# TMS 环境变量示例
# -----------------------------------------------------------------------------
# 使用方法：
#   cp .env.example .env
#
# 本文件适合本地开发环境直接复制使用。生产环境必须重新生成 SECRET_KEY，
# 设置 DEBUG=False，并改用真实域名、数据库和私有文件目录。

# -----------------------------------------------------------------------------
# Django 核心设置
# -----------------------------------------------------------------------------
# 本地开发示例值。生产环境必须替换为强随机密钥。
SECRET_KEY=django-insecure-local-development-only-change-me

# 本地开发可设为 True；生产环境必须设为 False。
DEBUG=True

# 多个值使用英文逗号分隔。
ALLOWED_HOSTS=localhost,127.0.0.1

# 只有在跨域或反向代理 HTTPS 场景下才需要配置。
# 示例：CSRF_TRUSTED_ORIGINS=https://tms.example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# 数据库配置
# -----------------------------------------------------------------------------
# SQLite（本地开发默认）
DATABASE_URL=sqlite:///db.sqlite3

# 生产环境建议使用 PostgreSQL 或 MySQL，不建议继续使用 SQLite。

# PostgreSQL 示例
# DATABASE_URL=postgres://tms:password@127.0.0.1:5432/tms

# MySQL 示例
# DATABASE_URL=mysql://tms:password@127.0.0.1:3306/tms

# -----------------------------------------------------------------------------
# 项目运行参数
# -----------------------------------------------------------------------------
# 缓存超时时间，单位：秒。默认值来自 core/constants.py。
CACHE_TIMEOUT=300

# 上传文件最大尺寸，单位：MB。默认值来自 core/constants.py。
UPLOAD_MAX_SIZE_MB=100

# 私有上传文件根目录；不要通过 Nginx、Apache 等 Web 服务器直接暴露。
PRIVATE_MEDIA_ROOT=media-private

# -----------------------------------------------------------------------------
# Samba 集成
# -----------------------------------------------------------------------------
# 默认关闭，避免未配置服务器环境时误触发系统级 Samba 操作。
# 需要使用 Samba 用户/共享目录集成功能时，再显式改为 True。
SAMBA_INTEGRATION_ENABLED=False
SAMBA_ASYNC_OPERATIONS_ENABLED=False
SAMBA_COMMAND_TIMEOUT_SECONDS=15
SAMBA_OPERATION_STALE_MINUTES=30

# 生产环境建议设置独立 Fernet 密钥；未设置时业务代码可能从 SECRET_KEY 派生。
# SAMBA_TASK_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 生产环境最小示例
# -----------------------------------------------------------------------------
# SECRET_KEY=replace-with-a-strong-random-secret-key
# DEBUG=False
# ALLOWED_HOSTS=tms.example.com,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://tms.example.com
# DATABASE_URL=postgres://tms:password@127.0.0.1:5432/tms
# PRIVATE_MEDIA_ROOT=/srv/tms/media-private
# SAMBA_INTEGRATION_ENABLED=False
# SAMBA_ASYNC_OPERATIONS_ENABLED=False
