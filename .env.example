# -----------------------------------------------------------------------------
# TMS environment example
# -----------------------------------------------------------------------------
# Usage:
#   cp .env.example .env
#
# This file is suitable for local development. For production, generate a new
# SECRET_KEY, set DEBUG=False, and use the real domain name, database, and
# private media path.

# -----------------------------------------------------------------------------
# Django core settings
# -----------------------------------------------------------------------------
# Local development example value. Replace it in production.
SECRET_KEY=local-development-example-key-change-me

# Use True for local development. Production must use False.
DEBUG=True

# Comma-separated values.
ALLOWED_HOSTS=localhost,127.0.0.1

# Set this only when cross-origin HTTPS or reverse proxy CSRF trusted origins
# are required. Leave it commented out when not needed.
# CSRF_TRUSTED_ORIGINS=https://tms.example.test

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite for local development.
DATABASE_URL=sqlite:///db.sqlite3

# Production uses PostgreSQL 17 instead of SQLite.

# PostgreSQL example
# DATABASE_URL=postgres://tms:change-me@127.0.0.1:5432/tms

# -----------------------------------------------------------------------------
# Project runtime settings
# -----------------------------------------------------------------------------
# Cache timeout in seconds. Default value comes from core/constants.py.
CACHE_TIMEOUT=300

# Upload file size limit in MB. Default value comes from core/constants.py.
UPLOAD_MAX_SIZE_MB=100

# Private upload root. Do not expose this directory directly through Nginx,
# Apache, or any other web server.
PRIVATE_MEDIA_ROOT=media-private

# -----------------------------------------------------------------------------
# Samba integration
# -----------------------------------------------------------------------------
# Disabled by default to avoid accidental system-level Samba operations before
# the server environment has been configured intentionally.
SAMBA_INTEGRATION_ENABLED=False
SAMBA_ASYNC_OPERATIONS_ENABLED=False
SAMBA_COMMAND_TIMEOUT_SECONDS=15
SAMBA_OPERATION_STALE_MINUTES=30

# Use an independent Fernet key in production when Samba async task encryption
# is required.
# SAMBA_TASK_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Minimal production example
# -----------------------------------------------------------------------------
# SECRET_KEY=generate-a-strong-random-value
# DEBUG=False
# ALLOWED_HOSTS=tms.example.test,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://tms.example.test
# DATABASE_URL=postgres://tms:change-me@127.0.0.1:5432/tms
# PRIVATE_MEDIA_ROOT=/srv/tms/media-private
# SAMBA_INTEGRATION_ENABLED=False
# SAMBA_ASYNC_OPERATIONS_ENABLED=False
