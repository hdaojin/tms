# Django设置
SECRET_KEY=ChangeMe-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://itnsa.cn:8080,https://itnsa.cn:8080

# 数据库配置
# SQLite (默认)
DATABASE_URL=sqlite:///db.sqlite3

# 生产环境建议使用其他数据库，如 PostgreSQL 或 MySQL

# PostgreSQL示例
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# MySQL示例
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# 自定义变量，根据不同的运行环境进行调整，可以覆盖 core/constants.py 中的默认值
# 缓存超时时间(单位：秒, 通过 settings.py 引用自core/constants.py 的默认值300)
CACHE_TIMEOUT=10

# 上传文件最大尺寸(单位：MB, 通过 settings.py 引用自core/constants.py 的默认值100)
UPLOAD_MAX_SIZE_MB=100

# 私有上传文件根目录；不要通过 Web 服务器直接暴露
PRIVATE_MEDIA_ROOT=media-private

# Samba 集成
SAMBA_INTEGRATION_ENABLED=True
SAMBA_ASYNC_OPERATIONS_ENABLED=True
SAMBA_COMMAND_TIMEOUT_SECONDS=15
SAMBA_OPERATION_STALE_MINUTES=30
# 生产环境建议设置独立 Fernet 密钥；未设置时会从 SECRET_KEY 派生
# SAMBA_TASK_ENCRYPTION_KEY=
