# Django设置
SECRET_KEY=ChangeMe-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置
# SQLite (默认)
DATABASE_URL=sqlite:///db.sqlite3

# 生产环境建议使用其他数据库，如 PostgreSQL 或 MySQL

# PostgreSQL示例
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# MySQL示例
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Custom
# 注册邀请码过期的时间（单位：秒, 在 settings.py 中有默认值86400）
# INVITATION_CODE_TIMEOUT=86400

# 缓存超时时间(单位：秒, 在 settings.py 中有默认值300)
CACHE_TIMEOUT=10

