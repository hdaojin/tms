{
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@iconify/json": "^2.2.546",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.50",
    "filepond": "beta",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build:css": "tailwindcss --input static/css/main.css --output static/css/output.css --minify",
    "build:frontend": "node scripts/sync-frontend-vendor.mjs && npm run build:css",
    "watch:css": "tailwindcss --input static/css/main.css --output static/css/output.css --watch",
    "test:frontend": "node scripts/sync-frontend-vendor.mjs --check && node --test scripts/test-filepond.mjs scripts/test-list-bulk-actions.mjs scripts/test-pdf-preview.mjs scripts/test-meeting-recipients.mjs",
    "format:frontend": "prettier --write package.json \"scripts/**/*.mjs\" \"static/css/main.css\"",
    "format:frontend:check": "prettier --check package.json \"scripts/**/*.mjs\" \"static/css/main.css\""
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-jinja-template",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "static/css/main.css",
    "overrides": [
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "jinja-template"
        }
      }
    ]
  },
  "name": "tms",
  "version": "1.0.0",
  "description": "TMS（Training Management System）是一个基于 Django 的培训与竞赛管理系统，用于统一管理训练过程、考核资料、会议记录、通知公告和用户角色权限。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdaojin/tms.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hdaojin/tms/issues"
  },
  "homepage": "https://github.com/hdaojin/tms#readme",
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
