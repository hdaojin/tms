{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "htmx.org": "^2.0.6",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.22",
    "@iconify/tailwind4": "^1.0.6",
    "daisyui": "^5.0.50",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1"
  },
  "scripts": {
    "build:css": "tailwindcss --input static/css/main.css --output static/css/output.css --minify",
    "watch:css": "tailwindcss --input static/css/main.css --output static/css/output.css --watch"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "static/css/main.css"
  }
}
