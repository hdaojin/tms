{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@upstash/context7-mcp": "^2.2.1",
    "alpinejs": "^3.15.6",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.428",
    "@iconify/tailwind4": "^1.0.6",
    "@tailwindcss/typography": "^0.5.19",
    "daisyui": "^5.0.50",
    "prettier": "^3.6.2",
    "prettier-plugin-jinja-template": "^2.1.0",
    "prettier-plugin-tailwindcss": "^0.7.1"
  },
  "scripts": {
    "build:css": "tailwindcss --input static/css/main.css --output static/css/output.css --minify",
    "watch:css": "tailwindcss --input static/css/main.css --output static/css/output.css --watch"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-jinja-template",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "static/css/main.css",
    "overrides": [
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "jinja-template"
        }
      }
    ]
  },
  "name": "tms",
  "version": "1.0.0",
  "description": "TMS（Training Management System）是一个基于 Django 的培训与竞赛管理系统，用于统一管理训练过程、考核资料、会议记录、通知公告和用户角色权限。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdaojin/tms.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hdaojin/tms/issues"
  },
  "homepage": "https://github.com/hdaojin/tms#readme"
}
